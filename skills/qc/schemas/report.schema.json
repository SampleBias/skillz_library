{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QC assessment and checkpoint report v0.1",
  "description": "Structure only; arithmetic, evidence freshness, approvals and lifecycle invariants require independent evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "assessed_at",
    "scope",
    "candidate",
    "policy",
    "checks",
    "categories",
    "findings",
    "score",
    "decision",
    "state",
    "next_action",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description",
        "requirements"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "milestone",
            "project"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "branch",
        "git_status",
        "snapshot_sha256",
        "snapshot_method",
        "files",
        "external_inputs"
      ],
      "properties": {
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "snapshot_method": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "external_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "file_threshold",
        "milestone_threshold",
        "category_maximums",
        "severity_deductions",
        "critical_always_rejects",
        "mandatory_failure_rejects",
        "missing_mandatory_evidence_blocks"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "file_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "milestone_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "category_maximums": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correctness",
            "rust_safety",
            "testing",
            "maintainability",
            "security",
            "reliability"
          ],
          "properties": {
            "correctness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "rust_safety": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "testing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "maintainability": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "security": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "reliability": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "severity_deductions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "critical_always_rejects": {
          "const": true
        },
        "mandatory_failure_rejects": {
          "const": true
        },
        "missing_mandatory_evidence_blocks": {
          "const": true
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "BLOCKED"
      ]
    },
    "state": {
      "enum": [
        "IMPLEMENTING",
        "VERIFYING",
        "QC_REVIEW",
        "REPAIR",
        "ACCEPTED_MILESTONE",
        "AWAITING_PUSH_APPROVAL",
        "AWAITING_PUSH_CONFIRMATION",
        "PAUSED",
        "READY_FOR_HUMAN_TESTING",
        "AWAITING_HUMAN_TEST",
        "COMPLETE"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "human_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person",
        "record",
        "candidate"
      ],
      "properties": {
        "person": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "decision",
        "report"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "decision": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "BLOCKED"
          ]
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mandatory",
        "status",
        "evidence",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "maximum",
        "raw_deductions",
        "score",
        "evidence"
      ],
      "properties": {
        "name": {
          "enum": [
            "correctness",
            "rust_safety",
            "testing",
            "maintainability",
            "security",
            "reliability"
          ]
        },
        "maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "raw_deductions": {
          "type": "integer",
          "minimum": 0
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "criterion",
        "severity",
        "deduction",
        "root_cause",
        "locations",
        "evidence",
        "severity_rationale",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "correctness",
            "rust_safety",
            "testing",
            "maintainability",
            "security",
            "reliability"
          ]
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "deduction": {
          "type": "integer",
          "minimum": 0
        },
        "root_cause": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "severity_rationale": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "outstanding",
        "vers_evidence",
        "intended_remote",
        "intended_ref",
        "intended_commit",
        "durable_snapshot",
        "approvals",
        "previous_state",
        "resume_conditions"
      ],
      "properties": {
        "completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outstanding": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vers_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intended_remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "intended_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "intended_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "durable_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previous_state": {
          "type": "string",
          "minLength": 1
        },
        "resume_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "COMPLETE"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "human_signoff"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "AWAITING_PUSH_APPROVAL",
              "AWAITING_PUSH_CONFIRMATION",
              "PAUSED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "checkpoint"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ACCEPT"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "score": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
